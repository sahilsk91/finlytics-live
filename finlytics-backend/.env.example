# Finlytics Backend — Production env
# Copy to .env and fill. In hosting dashboards, set these as env vars instead.

# Database — Neon (free tier) is recommended
# Get a free Postgres URL at https://neon.tech → Create Project → Connection string
# Example: postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Local fallback: if DATABASE_URL is empty, SQLite at finlytics.db is used.

# Auth — generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# CORS — your deployed frontend URL(s), comma-separated. * allows all (dev only)
FRONTEND_URL=https://your-frontend.vercel.app
# FRONTEND_URL=https://finlytics.vercel.app,https://finlytics.netlify.app

# Flask
FLASK_ENV=production
PORT=5000

# Optional: allow unauthenticated requests for local testing (do NOT set in prod)
# ALLOW_ANON=1
